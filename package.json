{
  "name": "shorts-atlas",
  "version": "0.1.0",
  "description": "Search a word, song title or theme and see YouTube Shorts about it on a world map.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "sync": "cp worker/src/guardrails.js web/js/guardrails.js",
    "build:gazetteer": "node scripts/build-gazetteer.mjs",
    "vendor": "cp node_modules/maplibre-gl/dist/maplibre-gl-csp.js node_modules/maplibre-gl/dist/maplibre-gl-csp-worker.js node_modules/maplibre-gl/dist/maplibre-gl.css node_modules/maplibre-gl/dist/LICENSE.txt web/vendor/",
    "serve": "npx --yes http-server web -p 8080 -c-1",
    "deploy": "cd worker && npx wrangler deploy"
  },
  "license": "MIT",
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "all-the-cities": "^3.1.0",
    "world-countries": "^5.1.0"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.1"
  },
  "type": "module",
  "private": true
}
